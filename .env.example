# --- SMART MENU PRO environment ---
# Admin login (change before going live). Password is stored hashed at first run.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
# Secret used to sign the admin session cookie. Generate: openssl rand -hex 32
SESSION_SECRET=replace-with-64-hex-chars
# Where the SQLite database file lives (default ./data/smartmenu.db)
DATABASE_PATH=./data/smartmenu.db
# Public base URL of the site (used for QR codes, sitemap, Open Graph)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# OPTIONAL: activates the LLM-powered phrasing of the AI Business Advisor.
# Without a key the advisor still works fully from real data using its built-in analysis engine.
OPENAI_API_KEY=
